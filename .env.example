# SAP Connection Settings

# ─── Option A: Basic Auth (on-premise / Private Cloud) ────────────────────────
SAP_URL=https://example.sap-server.com:44300
SAP_USER=EXAMPLE_USER
SAP_PASSWORD=your_password_here
SAP_CLIENT=100
SAP_LANGUAGE=EN

# ─── Option B: OAuth 2.0 Client Credentials (BTP / Public Cloud) ──────────────
# When these three vars are set, SAP_USER/SAP_PASSWORD are ignored.
# SAP_OAUTH_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
# SAP_CLIENT_ID=sb-your-client-id
# SAP_CLIENT_SECRET=your-client-secret
# SAP_URL=https://<tenant>-api.s4hana.cloud.sap
# SAP_LANGUAGE=EN

# ─── Option C: Browser login (S/4HANA Cloud Public Edition / GROW) ───────────
# Opens your browser to log in with email/password (+2FA), like Eclipse ADT.
# No password is stored. Requires the business role SAP_BR_DEVELOPER (dev tenant).
# SAP_AUTH_TYPE=browser
# SAP_URL=https://myXXXXXX.s4hana.cloud.sap
# SAP_LANGUAGE=EN

# ─── Safety ───────────────────────────────────────────────────────────────────
# Set to true ONLY on development systems to allow write operations.
SAP_ALLOW_WRITE=false
